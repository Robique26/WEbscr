# Copiază fișierul ca .env și completează. .env NU se pune pe git.

# Token de la @BotFather
TELEGRAM_TOKEN=
# Chat ID-urile care pot folosi botul (afla-l cu /start). Separate prin virgulă.
ALLOWED_CHAT_IDS=

# La câte minute verifică toate produsele
CHECK_INTERVAL_MIN=15
# Cereri simultane: total / pe același site
MAX_CONCURRENCY=16
PER_DOMAIN_CONCURRENCY=2
REQUEST_TIMEOUT=20
MAX_RETRIES=3

# Ignoră variații mai mici de X% (0 = anunță orice schimbare)
MIN_CHANGE_PCT=0
# 1 = anunță și scumpirile, 0 = doar ieftinirile
NOTIFY_ON_RISE=1
FAILS_BEFORE_WARNING=3

# 1 = folosește Chrome headless pentru site-urile care încarcă prețul din JavaScript
# (necesită: pip install playwright && playwright install chromium)
USE_BROWSER_FALLBACK=0

DB_PATH=pricebot.db
LOG_FILE=pricebot.log
